---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import WorkDemo from '../editorial/WorkDemo.astro';
import MotionRuntime from '../editorial/MotionRuntime.astro';
import portrait from '../../assets/chi-an-chen.webp';
import { education, profiles, pageUrl as basePageUrl } from '../../data/profile';
import { researchThemes } from '../../data/research';
import { retrievalWork } from '../../data/engineering';
import { translator, dateLabel, type Locale } from '../../i18n';
import '../../styles/portfolio.css';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = translator(locale);
const pageUrl = (id: Parameters<typeof basePageUrl>[0]) => basePageUrl(id, locale);
const selected = [researchThemes[0], researchThemes[1], retrievalWork];
const labels = ['Graduate research', 'Collaborative research', 'Applied engineering'];
---
<Layout locale={locale} title={t("Chi-An Chen — AI Research & Engineering")} description={t("Chi-An Chen studies and builds AI systems across language and vision, connecting model adaptation and evaluation with retrieval-based applications.")} currentPage="home">
  <MotionRuntime />
  <section slot="opening" class="prologue" aria-label={t("Opening statement")}>
    <div class="container prologue-content">
    <p class="prologue-statement" lang="en"><span>From perception,</span>{' '}<span>to reasoning,</span>{' '}<span>to practice.</span></p>
    <a class="prologue-next" href="#site-header">{t("Scroll down")} <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <section class="portfolio-hero" aria-labelledby="intro-title">
    <div class="hero-introduction">
      <p class="kicker">{t("AI research & engineering")}</p>
      <h1 id="intro-title" tabindex="-1">{locale === 'en' ? 'Chi-An Chen' : '陳麒安'}</h1>
      {locale === 'zh-Hant' && <p class="name-english" lang="en">Chi-An Chen</p>}
      <p class="hero-focus">{t("Seeing clearly.")}<br />{t("Reasoning carefully.")}</p>
      <p class="hero-description">{t("I study agricultural vision-language models and build AI systems that connect data, reasoning, and practical use.")}</p>
      <div class="editorial-actions"><a class="editorial-link" href="#selected-title">{t("Explore selected work")} <span aria-hidden="true">↓</span></a><a class="editorial-link secondary" href={pageUrl('experience')}>{t("View experience")} <span aria-hidden="true">↗</span></a></div>
    </div>
    <div class="hero-profile">
      <div class="portrait-frame"><Image class="portfolio-portrait" src={portrait} alt={t("Portrait of Chi-An Chen in graduation attire")} width={480} height={663} loading="eager" fetchpriority="high" /></div>
      <p class="profile-caption">{t("M.S. Student · Computer Science")}<br /><span>{t("National Ilan University, Taiwan")}</span></p>
    </div>
    <nav class="hero-work-index" aria-label={t("Selected work")}>{selected.map((item,i) => <a href={`#selected-${item.id}`}><span class="index-number">0{i+1}</span><span>{t(i===0 ? 'Agricultural VLMs' : i===1 ? 'Reasoning & verification' : 'Retrieval applications')}</span><span aria-hidden="true">↘</span></a>)}</nav>
  </section>
  <section class="portfolio-work" aria-labelledby="selected-title">
    <div class="section-top"><h2 id="selected-title" tabindex="-1">{t("Three ways into the work.")}</h2><p>{t("Research questions. Practical systems.")}</p></div>
    {selected.map((item,i) => <article class:list={['portfolio-case', `portfolio-case--${item.visual}`]} id={`selected-${item.id}`} aria-labelledby={`case-title-${i}`}>
      <div class="case-copy">
        <p class="kicker">0{i+1} / {t(labels[i])}</p>
        <h3 id={`case-title-${i}`}>{t(item.portfolio!.title)}</h3>
        <dl class="case-facts">{[['The question',item.portfolio!.problem],['My work',item.portfolio!.contribution],['The outcome',item.portfolio!.result]].map(([label,copy]) => <div><dt>{t(label)}</dt><dd>{t(copy)}</dd></div>)}</dl>
        <a class="editorial-link" href={`${pageUrl(i===2 ? 'experience' : 'research')}#${item.id}`}>{t(i===2 ? 'Explore the engineering' : 'Explore the research')} <span aria-hidden="true">↗</span></a>
      </div>
      <WorkDemo locale={locale} kind={item.visual!} />
    </article>)}
  </section>
  <section class="portfolio-background" aria-labelledby="background-title">
    <div><p class="kicker">{t("Background")}</p><h2 id="background-title">{t("Research meets practice.")}</h2></div>
    <div><p>{t("I am an R&D Engineer Intern at PAPAGO! My previous roles at National Ilan University include computer vision research and AI development through industry–academia collaboration.")}</p>
    <ul class="education-lines plain-list" role="list">{education.map(degree => <li><span>{t(degree.shortTitle)}</span><span>{dateLabel(degree.startLabel, locale)}–{dateLabel(degree.endLabel, locale)}</span></li>)}</ul>
    <div class="editorial-actions"><a class="editorial-link" href={pageUrl('about')}>{t("More about me")} <span aria-hidden="true">↗</span></a><a class="editorial-link secondary" href={`${pageUrl('research')}#publications-title`}>{t("Selected publications")} <span aria-hidden="true">↗</span></a></div></div>
  </section>
  <section class="portfolio-contact" aria-labelledby="continue-title"><p class="kicker">{t("Get in touch")}</p><h2 id="continue-title">{t("A good question is a good start.")}</h2><p>{t("For research conversations and engineering opportunities.")}</p><a class="editorial-link" href={profiles.linkedin}>{t("Connect on LinkedIn")} <span aria-hidden="true">↗</span></a></section>
</Layout>
