---
import Layout from '../../layouts/Layout.astro';
import ConceptFigure from '../editorial/ConceptFigure.astro';
import MotionRuntime from '../editorial/MotionRuntime.astro';
import { publications } from '../../data/publications';
import { researchThemes } from '../../data/research';
import { pageUrl as basePageUrl } from '../../data/profile';
const [vlm, reasoning, vision] = researchThemes;
const paperAnchor = (id: string) => {
  const index = publications.findIndex(paper => paper.id === id);
  if (index < 0 || !vision.publicationIds.includes(id as (typeof vision.publicationIds)[number])) {
    throw new Error(`Unknown visual-research publication: ${id}`);
  }
  return `publication-${index + 1}`;
};

import { translator, type Locale } from '../../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = translator(locale);
const pageUrl = (id: Parameters<typeof basePageUrl>[0]) => basePageUrl(id, locale);
---
<Layout locale={locale} title={t("Research — Chi-An Chen")} description={t("Research in agricultural vision-language models, collaborative small-model reasoning and verification, and visual recognition and medical image segmentation.")} currentPage="research">
  <MotionRuntime />
  <header class="research-heading"><p class="kicker">{t("Questions, methods & publications")}</p><h1>{t("Research")}</h1><p class="research-lead">{t("Understanding images.")}<br />{t("Reasoning with language.")}</p><p class="research-introduction">{t("My research examines how supervision and model structure shape visual grounding and reasoning under computational constraints. I study fine-grained agricultural recognition, the costs and benefits of structured mathematical reasoning, and task-specific architectures for biometric recognition and medical image segmentation.")}</p></header>
  <div class="research-fieldbook" data-fieldbook>
  <nav class="theme-index" aria-label={t("Research themes")}><ol class="plain-list" role="list">{researchThemes.map((theme,i) => <li><a href={`#${theme.id}`}><span>0{i+1}</span>{t(theme.shortTitle)}<span aria-hidden="true">↓</span></a></li>)}</ol></nav>
  <section class="research-theme" id={vlm.id} aria-labelledby="vlm-title"><header data-reveal-group>
    <p class="kicker" data-reveal>{t("01 / Graduate research")}</p><h2 id="vlm-title" data-reveal="second">{t(vlm.title)}</h2>
    <p class="research-question" data-reveal="third">{t(vlm.question)}</p></header>
    <div class="research-split"><div class="research-copy"><h3>{t("My contribution")}</h3><p>{t(vlm.contribution)}</p><h3>{t("Approach")}</h3>{vlm.approach?.map(paragraph => <p>{t(paragraph)}</p>)}</div><ConceptFigure locale={locale} kind="vlm" /></div>
    <div class="method-notes"><h3>{t("Methods in context")}</h3><p>{vlm.methods.map(t).join(' · ')}</p></div>
    <details class="research-detail"><summary>{t("More on supervision and evaluation")}</summary><div><p>{t("Teacher-generated descriptions focus on observable morphology without naming a diagnosis; bounded rationales connect visible symptoms to a class label. Direct-label targets use dataset annotations, and all examples derived from the same image remain in the same data split.")}</p><p>{t("Long-form reasoning with explicit self-checking belongs to the preliminary comparison, rather than the required output format of CROP. Cross-domain evaluation also highlights remaining challenges from distribution shift and visually similar disease classes.")}</p></div></details>
  </section>
  <section class="research-theme" id={reasoning.id} aria-labelledby="reasoning-title"><header data-reveal-group><p class="kicker" data-reveal>{t("02 / Collaborative research")}</p><h2 id="reasoning-title" data-reveal="second">{t(reasoning.title)}</h2><p class="research-question" data-reveal="third">{t(reasoning.question)}</p></header><div class="research-split research-split--reverse"><div class="research-copy"><h3>{t("My contribution")}</h3><p>{t(reasoning.contribution)}</p><h3>{t("Approach")}</h3>{reasoning.approach?.map(paragraph => <p>{t(paragraph)}</p>)}</div><ConceptFigure locale={locale} kind="reasoning" /></div><div class="method-notes"><h3>{t("Methods in context")}</h3><p>{reasoning.methods.map(t).join(' · ')}</p></div></section>
  <section class="research-theme" id={vision.id} aria-labelledby="vision-title"><header data-reveal-group><p class="kicker" data-reveal>{t("03 / Computer vision foundation")}</p><h2 id="vision-title" data-reveal="second">{t(vision.title)}</h2><p class="research-question" data-reveal="third">{t(vision.summary)}</p></header><div class="vision-contexts"><div><h3>{t("Lightweight biometric recognition")}</h3><p>{t("My research on LViT-CB explores lightweight finger vein recognition through competitive feature selection. The architecture combines convolutional patch embedding with feature competition blocks and attention. Competition across channel and spatial dimensions emphasizes discriminative vein patterns; evaluation considers identification, verification error, and computational cost.")}</p><a class="editorial-link" href={`#${paperAnchor('lvit-cb')}`}>{t("Related publication")} <span aria-hidden="true">↓</span></a></div><div><h3>{t("Medical image segmentation")}</h3><p>{t("My research explores complementary ways to model breast tumor structure in DCE-MRI. FAHU-Mamba combines selective scanning with learnable frequency reweighting to represent indistinct boundaries. SSIU-Net combines state space blocks and Mamba-inspired linear attention to capture local texture and long-range spatial relationships. Both are evaluated on BreastDM.")}</p><a class="editorial-link" href={`#${paperAnchor('fahu-mamba')}`}>{t("Related publications")} <span aria-hidden="true">↓</span></a></div></div><div class="method-notes"><h3>{t("Methods in context")}</h3><p>{vision.methods.map(t).join(' · ')}</p></div><p class="generative-note">{t("My earlier work also includes virtual try-on research and experience reproducing and adapting text-guided fashion-generation methods.")}</p></section>
  </div>
  <section class="editorial-publications" aria-labelledby="publications-title"><div class="section-top" data-reveal-group><h2 data-reveal id="publications-title">{t("Selected publications")}</h2><p>{t("A record of published work.")}</p></div><ol class="papers plain-list" role="list">{publications.map((paper,index) => <li id={`publication-${index+1}`} data-publication-id={paper.id}><div class="paper-meta"><span>{paper.venue}</span><time datetime={paper.year}>{paper.year}</time></div><div><h3 lang={paper.lang}>{paper.title}</h3><p class="paper-authors" lang={paper.lang}>{paper.authors}</p><p class="paper-description">{t(paper.description)}</p>{paper.award && <a class="editorial-link" href={`${pageUrl('about')}#paper-awards`}>{t("Paper recognition")} <span aria-hidden="true">↗</span></a>}</div></li>)}</ol></section>
  <section class="exploration-note" aria-labelledby="exploration-title"><p class="kicker">{t("Beyond the primary themes")}</p><h2 id="exploration-title">{t("Reproduction & exploration")}</h2><p>{t("I also work on paper-based implementations and evaluation workflows, including an fMRI signal-recovery reproduction project. These explorations involve translating research methods into data-processing, training, and evaluation pipelines.")}</p></section>
  <section class="editorial-continue" aria-labelledby="research-continue"><p class="kicker">{t("From research to practice")}</p><h2 id="research-continue">{t("The engineering behind the work.")}</h2><p>{t("Explore my experience building AI applications and working with data.")}</p><a class="editorial-link" href={pageUrl('experience')}>{t("View experience")} <span aria-hidden="true">↗</span></a></section>
</Layout>
<style>
 .research-heading { padding-block:64px 44px; }
 .research-heading h1 { font-size:clamp(3.5rem,7vw,6rem); letter-spacing:-.05em; }
 .research-heading .research-lead { margin-block:28px 20px; font-family:var(--display); font-size:clamp(1.875rem,3vw,2.75rem); line-height:1.2; letter-spacing:-.02em; }
 .research-introduction { max-width:760px; color:var(--muted); }
 .theme-index { border-block:1px solid var(--line); background:var(--paper); }
 .theme-index a { position:relative; }
 .theme-index a::after { content:''; position:absolute; left:0; right:0; bottom:12px; height:1px; background:var(--accent); transform:scaleX(0); transform-origin:left; }
 .theme-index a[aria-current='location']::after { transform:scaleX(1); }
 .theme-index a[aria-current='location'] span:first-child { color:var(--accent); }
 @media(prefers-reduced-motion:no-preference) { .theme-index a::after { transition:transform 160ms var(--motion-ease); } }
 @media(min-width:1024px) and (min-height:640px) {
  .fieldbook-ready .theme-index { position:sticky; top:0; z-index:1; }
  .fieldbook-ready .research-theme { scroll-margin-top:var(--fieldbook-offset); }
  .fieldbook-ready :global([id]), .fieldbook-ready :global(:focus) { scroll-margin-top:var(--fieldbook-offset); }
 }
 @media print { .fieldbook-ready .theme-index { position:static; } }
 .theme-index ol { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:24px; }
 .theme-index a { display:flex; align-items:center; gap:14px; text-decoration:none; padding-block:20px; font-size:1.0625rem; }
 .theme-index a span:first-child { color:var(--muted); font-size:.8125rem; }
 .theme-index a span:last-child { margin-left:auto; }
 .research-theme { padding-block:80px; scroll-margin-top:24px; }
 .research-theme + .research-theme { border-top:1px solid var(--line); }
 .research-theme > header > h2 { max-width:860px; font-size:clamp(2.125rem,4.25vw,3.5rem); line-height:1.15; letter-spacing:-.035em; }
 .research-theme .research-question { max-width:820px; font-size:1.5rem; line-height:1.5; margin-top:28px; }
 .research-split { display:grid; grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr); gap:80px; margin-top:48px; align-items:start; }
 .research-copy h3,.vision-contexts h3,.method-notes h3 { font-family:inherit; font-size:1.125rem; font-weight:600; margin-bottom:12px; }
 .research-copy p + h3 { margin-top:32px; }
 .research-copy p { color:var(--muted); }
 .research-copy p + p { margin-top:16px; }
 .research-split--reverse .research-copy { grid-column:2; grid-row:1; }
 .research-split--reverse > figure { grid-column:1; grid-row:1; }
 .method-notes { display:grid; grid-template-columns:180px minmax(0,1fr); gap:28px; border-top:1px solid var(--line); padding-top:24px; margin-top:40px; }
 .method-notes p { color:var(--muted); font-size:1rem; }
 .research-detail { border-block:1px solid var(--line); margin-top:24px; }
 summary { cursor:pointer; padding-block:18px; color:var(--accent); min-height:48px; }
 .research-detail > div { max-width:760px; padding-bottom:24px; }
 .research-detail p { color:var(--muted); }
 .research-detail p + p { margin-top:16px; }
 .vision-contexts { display:grid; grid-template-columns:1fr 1fr; gap:64px; margin-top:40px; }
 .vision-contexts p { color:var(--muted); }
 .vision-contexts .editorial-link { margin-top:16px; }
 .generative-note { max-width:800px; margin-top:28px; color:var(--muted); }
 .papers { margin-top:32px; }
 .papers > li { display:grid; grid-template-columns:132px minmax(0,1fr); gap:48px; padding-block:32px; border-bottom:1px solid var(--line); scroll-margin-top:24px; }
 .paper-meta { display:flex; flex-direction:column; gap:6px; color:var(--accent); font-size:.9375rem; }
 .paper-meta time { color:var(--muted); }
 .papers h3 { font-family:var(--display); font-size:1.75rem; font-weight:400; line-height:1.3; }
 .papers .paper-authors { font-size:1rem; color:var(--muted); margin-top:16px; }
 .papers .paper-description { font-size:1rem; margin-top:12px; }
 .papers .editorial-link { font-size:.9375rem; margin-top:12px; }
 .exploration-note { padding-block:56px; max-width:820px; }
 .exploration-note h2 { font-size:2rem; margin-bottom:20px; }
 .exploration-note > p:not(.kicker) { color:var(--muted); }
 @media(max-width:1000px) { .research-split { gap:40px; } }
 @media(max-width:800px) {
  .research-split,.vision-contexts { grid-template-columns:minmax(0,1fr); gap:32px; }
  .research-split--reverse .research-copy,.research-split--reverse > figure { grid-column:auto; grid-row:auto; }
  .theme-index ol { grid-template-columns:minmax(0,1fr); gap:0; }
  .theme-index li + li { border-top:1px solid var(--line); }
 }
 @media(max-width:600px) {
  .research-heading { padding-block:40px 32px; }
  .research-heading h1 { font-size:3.25rem; }
  .research-heading .research-lead { font-size:1.875rem; }
  .research-theme { padding-block:44px; }
  .research-theme .research-question { font-size:1.25rem; margin-top:20px; }
  .research-split { margin-top:28px; }
  .method-notes { grid-template-columns:minmax(0,1fr); gap:0; margin-top:28px; }
  .papers > li { grid-template-columns:minmax(0,1fr); gap:16px; }
  .paper-meta { flex-direction:row; gap:16px; }
  .papers h3 { font-size:1.5rem; }
  .exploration-note { padding-block:44px; }
 }
</style>
