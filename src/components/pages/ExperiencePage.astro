---
import Layout from '../../layouts/Layout.astro';
import MotionRuntime from '../editorial/MotionRuntime.astro';
import PageHeading from '../editorial/PageHeading.astro';
import SectionIndex from '../editorial/SectionIndex.astro';
import DateRange from '../editorial/DateRange.astro';
import ConceptFigure from '../editorial/ConceptFigure.astro';
import WorkDemo from '../editorial/WorkDemo.astro';
import { roles } from '../../data/roles';
import { engineeringWork, capabilityGroups } from '../../data/engineering';
import { pageUrl as basePageUrl } from '../../data/profile';

import { translator, type Locale } from '../../i18n';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = translator(locale);
const pageUrl = (id: Parameters<typeof basePageUrl>[0]) => basePageUrl(id, locale);
---
<Layout locale={locale} title={t("Experience — Chi-An Chen")} description={t("Engineering experience in retrieval applications, predictive modeling, data pipelines, and perception-model integration, alongside verified research and industry roles.")} currentPage="experience">
  <MotionRuntime />
  <PageHeading title={t("Experience")} eyebrow={t("Engineering in practice")} lead={t("From source data to working systems.")}><p>{t("My engineering work connects models with the information and interfaces around them. It spans retrieval applications, predictive modeling, data preparation, and inference integration.")}</p></PageHeading>
  <SectionIndex ariaLabel={t("Experience sections")} items={[{href:'#roles',label:t("Roles")},{href:'#engineering-work',label:t("Selected engineering work")},{href:'#capabilities',label:t("Capabilities") }]} showArrow />
  <section class="roles-section" id="roles" aria-labelledby="roles-title">
    <div class="section-label" data-reveal-group><p class="kicker" data-reveal>{t("Context")}</p><h2 id="roles-title" data-reveal="second">{t("Research & industry")}</h2></div>
    <ol class="roles editorial-record-list editorial-record-list--stack-800 plain-list" role="list" aria-label={t("Roles, most recent first")}>{roles.map(role => <li class="editorial-record" id={role.id} data-role-id={role.id}>
      <p class="role-date editorial-record__meta"><DateRange locale={locale} {...role} /></p>
      <div class="editorial-record__content"><h3>{t(role.title)}</h3><p class="role-organization">{t(role.organization)}{role.location && ` · ${t(role.location)}`}</p>{role.context && <p class="role-context">{t(role.context)}</p>}
      {role.relatedResearch && <a class="context-link" href={`${pageUrl('research')}#${role.relatedResearch}`}>{t("Related research")} <span aria-hidden="true">↗</span></a>}
      {role.relatedEngineeringWork && <a class="context-link" href={`#${role.relatedEngineeringWork}`}>{t("Selected engineering work")} <span aria-hidden="true">↓</span></a>}</div>
    </li>)}</ol>
  </section>
  <section id="engineering-work" aria-labelledby="work-title">
    <div class="section-top" data-reveal-group><h2 data-reveal id="work-title">{t("Selected engineering work")}</h2><p>{t("Problems, contributions & integration.")}</p></div>
    {engineeringWork.map((work,i) => <article class:list={['engineering-case', i===0 && 'engineering-case--lead']} id={work.id} data-engineering-id={work.id}>
      <div class="case-heading" data-reveal-group><p class="kicker" data-reveal>0{i+1} / {t(i===0 ? 'Retrieval & document applications' : i===1 ? 'Predictive modeling & NLP' : i===2 ? 'Data engineering' : 'Perception & inference')}</p><h3 data-reveal="second">{t(work.title)}</h3><p class="case-summary">{t(work.summary)}</p></div>
      <dl class="case-narrative"><div><dt>{t("Problem")}</dt><dd>{t(work.problem)}</dd></div><div><dt>{t("My work")}</dt><dd>{t(work.contribution)}</dd></div><div><dt>{t("Integration")}</dt><dd>{t(work.integration)}</dd></div></dl>
      {work.visual && <div class="engineering-illustration"><WorkDemo locale={locale} kind={work.visual} /><details class="engineering-detail"><summary>{t("Full method overview")}</summary><ConceptFigure locale={locale} kind={work.visual} /></details></div>}
      <p class="case-methods"><span>{t("Methods in context")}</span>{work.methods.map(t).join(' · ')}</p>
    </article>)}
  </section>
  <section class="capabilities-section" id="capabilities" aria-labelledby="capabilities-title"><div class="section-label" data-reveal-group><p class="kicker" data-reveal>{t("Capabilities in context")}</p><h2 id="capabilities-title" data-reveal="second">{t("Skills, connected to work.")}</h2></div><ul class="capabilities plain-list" role="list">{capabilityGroups.map(capability => <li><h3>{t(capability.title)}</h3><p>{t(capability.description)}</p><a class="context-link" href={`${pageUrl(capability.page)}#${capability.anchor}`}>{t(capability.link)} <span aria-hidden="true">↗</span></a></li>)}</ul></section>
  <section class="editorial-continue" aria-labelledby="experience-continue" data-reveal-group><p class="kicker" data-reveal>{t("The background behind the work")}</p><h2 id="experience-continue" data-reveal="second">{t("Learning, research & collaboration.")}</h2><p>{t("Read about my academic background, recognition, and continued learning.")}</p><a class="editorial-link" href={pageUrl('about')}>{t("About me")} <span aria-hidden="true">↗</span></a></section>
</Layout>
<style>
 .roles-section { padding-block:64px 80px; }
 .section-label h2 { font-size:clamp(2rem,3.5vw,2.75rem); }
 .roles { margin-top:36px; }
 .roles .role-date { color:var(--muted); font-size:1rem; }
 .roles h3 { font-family:var(--display); font-weight:400; font-size:1.625rem; line-height:1.3; max-width:780px; }
 .roles .role-organization { color:var(--accent); font-size:1rem; margin-top:10px; }
 .role-context { margin-top:16px; max-width:760px; color:var(--muted); }
 .context-link { display:inline-flex; align-items:center; gap:16px; min-height:44px; font-size:1rem; margin-top:12px; }
 .engineering-case { padding-block:64px; border-bottom:1px solid var(--line); }
 .case-heading { max-width:820px; }
 .case-heading h3 { font-family:var(--display); font-weight:400; font-size:clamp(2rem,3.8vw,3rem); letter-spacing:-.025em; line-height:1.2; }
 .case-heading .case-summary { font-size:1.25rem; margin-top:24px; }
 .case-narrative { margin:36px 0 0; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:36px; }
 .case-narrative dt { font-weight:600; margin-bottom:12px; font-size:1.125rem; }
 .case-narrative dd { margin:0; color:var(--muted); font-size:1.125rem; line-height:1.6; }
 .engineering-case--lead .case-narrative { grid-template-columns:minmax(0,1fr); gap:24px; max-width:920px; }
 .engineering-case--lead .case-narrative > div { display:grid; grid-template-columns:152px minmax(0,1fr); gap:28px; }
 .engineering-illustration { max-width:640px; margin-top:36px; }
 .engineering-detail { margin-top:20px; }
 .engineering-detail summary { min-height:48px; padding-block:12px; cursor:pointer; color:var(--accent); }
 .engineering-case .case-methods { display:flex; flex-wrap:wrap; gap:8px 24px; margin-top:36px; padding-top:20px; border-top:1px solid var(--line); color:var(--muted); font-size:1rem; }
 .case-methods span { color:var(--ink); font-weight:600; }
 .capabilities-section { display:grid; grid-template-columns:1fr 1.65fr; gap:64px; padding-block:80px; }
 .capabilities li { padding-block:24px; border-top:1px solid var(--line); }
 .capabilities p { color:var(--muted); margin-top:12px; }
 @media(max-width:1000px) { .case-narrative { grid-template-columns:minmax(0,1fr); gap:24px; max-width:760px; } .capabilities-section { gap:36px; } }
 @media(max-width:800px) { .capabilities-section { grid-template-columns:minmax(0,1fr); } }
 @media(max-width:600px) {
  .roles-section,.engineering-case,.capabilities-section { padding-block:44px; }
  .roles { margin-top:28px; }
  .engineering-case--lead .case-narrative > div { grid-template-columns:minmax(0,1fr); gap:0; }
  .case-narrative dd { font-size:1.0625rem; }
  .case-heading .case-summary { font-size:1.1875rem; }
 }
</style>
