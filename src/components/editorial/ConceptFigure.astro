---
import type { ConceptKind } from '../../data/research';
import { translator, type Locale } from '../../i18n';
interface Props { kind: ConceptKind; locale?: Locale; }
const { kind, locale = 'en' } = Astro.props;
const t = translator(locale);
const steps = kind === 'vlm'
  ? [
    { title: 'Field images', detail: 'Fine-grained crop recognition' },
    { title: 'Three supervision signals', detail: 'Visual description · Bounded reasoning · Direct labeling' },
    { title: 'Joint fine-tuning', detail: 'Complementary targets in one training stage' },
    { title: 'Two inference modes', detail: 'Label only, or short rationale + label' },
  ]
  : [
    { title: 'Matched problems', detail: 'Shared examples across three conditions' },
    { title: 'Compare output schemas', detail: 'Compact CoT · Arithmetic markup · Added verification' },
    { title: 'Controlled comparison', detail: 'Fixed training and decoding' },
    { title: 'Assess costs & benefits', detail: 'Accuracy and format; separate error-recovery experiments' },
  ];
---
<figure class:list={['concept', `concept--${kind}`]} data-reveal-group data-reveal="figure">
  <div class="figure-heading"><span>{t("Method sketch")}</span><span aria-hidden="true">{kind === 'vlm' ? '01' : kind === 'reasoning' ? '02' : '03'}</span></div>
  {kind === 'retrieval' ? <div class="retrieval-flow">
    <ul class="sources plain-list" aria-label={t("Information sources")} role="list">
      <li tabindex="0"><span class="source-title">{t("Documents")}</span><span>{t("Retrieved passages")}</span></li>
      <li tabindex="0"><span class="source-title">{t("User query")}</span><span>{t("Question & context")}</span></li>
      <li tabindex="0"><span class="source-title">{t("Structured data")}</span><span>{t("Relevant records")}</span></li>
    </ul>
    <div class="compose"><span class="step-meta">{t("Bring together")}</span><strong>{t("Evidence")}<br />{t("composition")}</strong></div>
    <div class="response"><span class="step-meta">{t("Generate")}</span><strong>{t("Response")}</strong></div>
  </div> : <ol class="steps plain-list" role="list">
    {steps.map((step, i) => <li tabindex="0"><span class="step-meta">{String(i + 1).padStart(2, '0')}</span><div><span class="step-title">{t(step.title)}</span><span class="step-detail">{t(step.detail)}</span></div></li>)}
  </ol>}
  <figcaption>{t(kind === 'vlm' ? 'CROP: a conceptual view of decoupled supervision and inference.' : kind === 'reasoning' ? 'A conceptual view of the study design. Verification is a tested condition.' : 'A conceptual view of how different sources inform an answer.')} <span>{t("Not a literal model architecture.")}</span></figcaption>
</figure>
<style>
  .concept { margin:0; border-block:1px solid var(--line); padding:22px 0 20px; }
  .figure-heading { display:flex; justify-content:space-between; color:var(--accent); font-size:.8125rem; letter-spacing:.08em; text-transform:uppercase; }
  .steps { padding-block:26px; }
  .steps li { position:relative; display:flex; align-items:baseline; gap:22px; padding:14px 0; }
  .steps li + li::before { content:''; position:absolute; top:-4px; left:8px; height:12px; width:1px; background:var(--line); }
  .step-meta { color:var(--muted); font-size:.8125rem; }
  .steps .step-meta { flex:0 0 16px; white-space:nowrap; }
  .steps li > div { min-width:0; }
  .step-title { font-family:var(--display); color:var(--ink); font-size:1.625rem; line-height:1.2; }
  .step-detail { display:block; margin-top:8px; color:var(--muted); font-size:.875rem; line-height:1.5; }
  .steps li:last-child .step-title { color:var(--accent); }
  .concept--reasoning .steps { padding-block:28px; }
  .concept--reasoning .steps li { padding-block:18px; }
  figcaption { border-top:1px solid var(--line); padding-top:14px; color:var(--muted); font-size:.875rem; line-height:1.5; }
  figcaption span { display:block; }
  .retrieval-flow { display:grid; grid-template-columns:1.2fr 1fr .7fr; align-items:center; gap:72px; padding-block:36px; }
  .sources { position:relative; display:grid; gap:20px; }
  .sources::after { content:''; position:absolute; right:-24px; top:24px; bottom:24px; border-right:1px solid var(--line); }
  .sources li { position:relative; }
  .sources li::after { content:''; position:absolute; right:-24px; top:50%; width:16px; border-top:1px solid var(--line); }
  .sources span { display:block; font-size:.875rem; color:var(--muted); }
  .sources .source-title { color:var(--ink); font-size:1.125rem; }
  .compose,.response { position:relative; }
  .compose::before,.response::before { content:'→'; position:absolute; left:-46px; top:40%; color:var(--accent); }
  strong { display:block; font-family:var(--display); font-size:1.875rem; font-weight:400; line-height:1.25; margin-top:8px; }
  .response strong { color:var(--accent); }
  /* Inspection is transient and CSS-only. Keyboard focus wins over hover. */
  .steps li:focus-visible :is(.step-meta,.step-title),
  .sources li:focus-visible .source-title { color:var(--accent); }
  .steps li:focus-visible + li::before { background:var(--accent); width:2px; }
  .sources li:focus-visible::after,
  .sources:has(li:focus-visible)::after { border-color:var(--accent); border-width:2px; }
  .retrieval-flow:has(.sources li:focus-visible) .compose strong { color:var(--accent); }
  .retrieval-flow:has(.sources li:focus-visible) :is(.compose,.response)::before { text-shadow:.5px 0 currentColor; }
  @media(hover:hover) and (pointer:fine) {
    .concept:not(:has(:focus-visible)) .steps li:hover :is(.step-meta,.step-title),
    .concept:not(:has(:focus-visible)) .sources li:hover .source-title { color:var(--accent); }
    .concept:not(:has(:focus-visible)) .steps li:hover + li::before { background:var(--accent); width:2px; }
    .concept:not(:has(:focus-visible)) .sources li:hover::after,
    .concept:not(:has(:focus-visible)) .sources:has(li:hover)::after { border-color:var(--accent); border-width:2px; }
    .concept:not(:has(:focus-visible)) .retrieval-flow:has(.sources li:hover) .compose strong { color:var(--accent); }
    .concept:not(:has(:focus-visible)) .retrieval-flow:has(.sources li:hover) :is(.compose,.response)::before { text-shadow:.5px 0 currentColor; }
  }
  @media(prefers-reduced-motion:no-preference) {
    .step-title,.step-meta,.source-title,.compose strong { transition:color 160ms var(--motion-ease); }
    .steps li::before { transition:background-color 160ms var(--motion-ease); }
    .sources::after,.sources li::after { transition:border-color 160ms var(--motion-ease); }
  }
  @media(max-width:800px) {
    .retrieval-flow { grid-template-columns:1fr; gap:36px; padding-block:28px; }
    .sources { gap:18px; border-bottom:1px solid var(--line); padding-bottom:24px; }
    .sources::after,.sources li::after { display:none; }
    .compose::before,.response::before { content:'↓'; left:0; top:-28px; }
    .compose,.response { padding-top:4px; }
    .step-title { font-size:1.5rem; }
    strong { font-size:1.625rem; }
  }
</style>
