---
interface Props { title: string; eyebrow: string; lead: string; }
const { title, eyebrow, lead } = Astro.props;
---
<header class="page-heading"><p class="kicker">{eyebrow}</p><h1>{title}</h1><p class="page-lead">{lead}</p><div class="page-context"><slot /></div></header>
<style>
 .page-heading { padding-block:64px 48px; }
 .page-heading h1 { font-size:clamp(3.5rem,7vw,6rem); letter-spacing:-.05em; }
 .page-heading .page-lead { max-width:860px; font-family:var(--display); font-size:clamp(1.875rem,3vw,2.75rem); line-height:1.2; letter-spacing:-.02em; margin-top:28px; }
 .page-context { max-width:760px; margin-top:24px; color:var(--muted); }
 @media(max-width:600px) { .page-heading { padding-block:40px 32px; } .page-heading h1 { font-size:clamp(2.75rem,11vw,3.25rem); } }
</style>
