---
import { dateLabel, type Locale } from '../../i18n';
interface Props { locale?: Locale; start: string; startLabel: string; end: string | null; endLabel: string; }
const { start, startLabel, end, endLabel, locale = 'en' } = Astro.props;
---
<time datetime={start}>{dateLabel(startLabel, locale)}</time><span aria-hidden="true"> — </span><span class="sr-only">{locale === 'en' ? ' to ' : ' 至 '}</span>{end ? <time datetime={end}>{dateLabel(endLabel, locale)}</time> : dateLabel(endLabel, locale)}
