---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import ConceptFigure from '../components/editorial/ConceptFigure.astro';
import portrait from '../assets/chi-an-chen.webp';
import { education, pageUrl } from '../data/profile';
import { researchThemes, identityStatement } from '../data/research';
import { retrievalWork } from '../data/engineering';
const [vlm, reasoning] = researchThemes;
---
<Layout title="Chi-An Chen — AI Research & Engineering" description="Chi-An Chen studies and builds AI systems across language and vision, connecting model adaptation and evaluation with retrieval-based applications." currentPage="home">
  <section class="editorial-hero" aria-labelledby="intro-title">
    <div class="hero-person">
      <div><p class="kicker">AI research & engineering</p><h1 id="intro-title">Chi-An Chen</h1></div>
      <Image class="editorial-portrait" src={portrait} alt="Portrait of Chi-An Chen in graduation attire" width={480} height={663} loading="eager" fetchpriority="high" />
    </div>
    <p class="academic-context">M.S. Student in Computer Science and Information Engineering<br /><span>National Ilan University, Taiwan</span></p>
    <p class="identity-statement">{identityStatement}</p>
    <div class="editorial-actions"><a class="editorial-link" href={pageUrl('research')}>Explore research <span aria-hidden="true">↗</span></a><a class="editorial-link secondary" href={pageUrl('experience')}>View experience <span aria-hidden="true">↗</span></a></div>
  </section>
  <section class="selected-work" aria-labelledby="selected-title">
    <div class="section-top"><h2 id="selected-title">Selected work</h2><p>Research questions. Practical systems.</p></div>
    {[vlm, reasoning].map((theme, i) => <article class:list={['featured-work', i === 1 && 'featured-work--reverse']} id={`selected-${theme.id}`}>
      <div class="feature-copy"><p class="kicker">0{i + 1} / {i === 0 ? 'Graduate research' : 'Collaborative research'}</p><h3>{theme.title}</h3><p class="feature-summary">{theme.summary}</p><p>{theme.preview}</p><a class="editorial-link" href={`${pageUrl('research')}#${theme.id}`}>Explore the research <span aria-hidden="true">↗</span></a></div>
      <ConceptFigure kind={theme.visual!} />
    </article>)}
    <article class="featured-work featured-work--process" id={`selected-${retrievalWork.id}`}>
      <div class="feature-copy"><p class="kicker">03 / Applied engineering</p><h3>{retrievalWork.title}</h3><p class="feature-summary">{retrievalWork.summary}</p><p>{retrievalWork.contribution}</p><a class="editorial-link" href={`${pageUrl('experience')}#ai-engineering`}>View engineering experience <span aria-hidden="true">↗</span></a></div>
      <ConceptFigure kind="retrieval" />
    </article>
  </section>
  <section class="editorial-background" aria-labelledby="background-title"><div><p class="kicker">Background</p><h2 id="background-title">Across research<br />and practice.</h2></div><div>
    <p class="background-lead">I am an R&D Engineer Intern at PAPAGO! My previous roles at National Ilan University include computer vision research and AI development through industry–academia collaboration.</p>
    <ul class="education-lines plain-list" role="list">{education.map(degree => <li><span>{degree.shortTitle}</span><span>{degree.startLabel}–{degree.endLabel}</span></li>)}</ul>
    <p class="small-note">Computer Science and Information Engineering · National Ilan University</p>
    <div class="editorial-actions"><a class="editorial-link" href={pageUrl('experience')}>Experience <span aria-hidden="true">↗</span></a><a class="editorial-link" href={`${pageUrl('about')}#education`}>Education <span aria-hidden="true">↗</span></a></div>
  </div></section>
  <section class="editorial-continue" aria-labelledby="continue-title"><p class="kicker">Continue</p><h2 id="continue-title">A closer look.</h2><p>Explore the questions behind the work, or get in touch.</p><div class="editorial-actions"><a class="editorial-link" href={pageUrl('research')}>Research <span aria-hidden="true">↗</span></a><a class="editorial-link" href="https://www.linkedin.com/in/chi-an-chen-993590315">Connect on LinkedIn <span aria-hidden="true">↗</span></a></div></section>
</Layout>
