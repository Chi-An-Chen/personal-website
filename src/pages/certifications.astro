---
import Layout from '../layouts/Layout.astro';
import PageIntro from '../components/PageIntro.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import { credentials, courses } from '../data/resume';
---
<Layout title="Certifications — Chi-An Chen" description="Professional credentials and course completion in programming, AI, IoT, and applied computing, with issuers and dates." currentPage="certifications">
  <PageIntro title="Certifications" eyebrow="Credentials & continued learning" description="Credentials and continued learning in programming, AI, and applied computing." />
  {[
    {id:'credentials',title:'Credentials',items:credentials},
    {id:'courses',title:'Courses & workshops',items:courses},
  ].map(group => <section class="credential-section" aria-labelledby={group.id}>
    <h2 id={group.id}>{group.title}</h2>
    <ul class="credential-list plain-list">{group.items.map(item => <li>
      <div><h3>{item.name}</h3><p class="credential-issuer">{item.issuer}</p><p>{item.focus}</p>
        {item.name==='AI on Jetson Nano' && <p class="course-detail">“透過 Jetson Nano 開發人工智慧應用” (Apr 2023) and “Getting Started with AI on Jetson Nano” (Apr 2025).</p>}
      </div>
      <p class="credential-date">{item.date}</p>
    </li>)}</ul>
  </section>)}
  <div class="page-return"><RelatedLinks items={['skills', 'education']} /></div>
</Layout>
