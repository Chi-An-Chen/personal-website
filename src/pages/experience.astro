---
import Layout from '../layouts/Layout.astro';
import PageHeading from '../components/editorial/PageHeading.astro';
import DateRange from '../components/editorial/DateRange.astro';
import ConceptFigure from '../components/editorial/ConceptFigure.astro';
import { roles } from '../data/roles';
import { engineeringWork, capabilityGroups } from '../data/engineering';
import { pageUrl } from '../data/profile';
---
<Layout title="Experience — Chi-An Chen" description="Engineering experience in retrieval applications, predictive modeling, data pipelines, and perception-model integration, alongside verified research and industry roles." currentPage="experience">
  <PageHeading title="Experience" eyebrow="Engineering in practice" lead="From source data to working systems."><p>My engineering work connects models with the information and interfaces around them. It spans retrieval applications, predictive modeling, data preparation, and inference integration.</p></PageHeading>
  <nav class="experience-index" aria-label="Experience sections"><a href="#roles">Roles <span aria-hidden="true">↓</span></a><a href="#engineering-work">Selected engineering work <span aria-hidden="true">↓</span></a><a href="#capabilities">Capabilities <span aria-hidden="true">↓</span></a></nav>
  <section class="roles-section" id="roles" aria-labelledby="roles-title">
    <div class="section-label"><p class="kicker">Context</p><h2 id="roles-title">Research & industry</h2></div>
    <ol class="roles plain-list" role="list" aria-label="Roles, most recent first">{roles.map(role => <li id={role.id} data-role-id={role.id}>
      <p class="role-date"><DateRange {...role} /></p>
      <div><h3>{role.title}</h3><p class="role-organization">{role.organization}{role.location && ` · ${role.location}`}</p>{role.context && <p class="role-context">{role.context}</p>}
      {role.relatedResearch && <a class="context-link" href={`${pageUrl('research')}#${role.relatedResearch}`}>Related research <span aria-hidden="true">↗</span></a>}
      {role.relatedEngineeringWork && <a class="context-link" href={`#${role.relatedEngineeringWork}`}>Selected engineering work <span aria-hidden="true">↓</span></a>}</div>
    </li>)}</ol>
  </section>
  <section id="engineering-work" aria-labelledby="work-title">
    <div class="section-top"><h2 id="work-title">Selected engineering work</h2><p>Problems, contributions & integration.</p></div>
    {engineeringWork.map((work,i) => <article class:list={['engineering-case', i===0 && 'engineering-case--lead']} id={work.id} data-engineering-id={work.id}>
      <div class="case-heading"><p class="kicker">0{i+1} / {i===0 ? 'Retrieval & document applications' : i===1 ? 'Predictive modeling & NLP' : i===2 ? 'Data engineering' : 'Perception & inference'}</p><h3>{work.title}</h3><p class="case-summary">{work.summary}</p></div>
      <dl class="case-narrative"><div><dt>Problem</dt><dd>{work.problem}</dd></div><div><dt>My work</dt><dd>{work.contribution}</dd></div><div><dt>Integration</dt><dd>{work.integration}</dd></div></dl>
      {work.visual && <ConceptFigure kind={work.visual} />}
      <p class="case-methods"><span>Methods in context</span>{work.methods.join(' · ')}</p>
    </article>)}
  </section>
  <section class="capabilities-section" id="capabilities" aria-labelledby="capabilities-title"><div class="section-label"><p class="kicker">Capabilities in context</p><h2 id="capabilities-title">Skills, connected to work.</h2></div><ul class="capabilities plain-list" role="list">{capabilityGroups.map(capability => <li><h3>{capability.title}</h3><p>{capability.description}</p><a class="context-link" href={`${pageUrl(capability.page)}#${capability.anchor}`}>{capability.link} <span aria-hidden="true">↗</span></a></li>)}</ul></section>
  <section class="editorial-continue" aria-labelledby="experience-continue"><p class="kicker">The background behind the work</p><h2 id="experience-continue">Learning, research & collaboration.</h2><p>Read about my academic background, recognition, and continued learning.</p><a class="editorial-link" href={pageUrl('about')}>About me <span aria-hidden="true">↗</span></a></section>
</Layout>
<style>
 .experience-index { display:flex; flex-wrap:wrap; gap:8px 40px; padding-block:12px; border-block:1px solid var(--line); }
 .experience-index a { display:flex; gap:20px; align-items:center; min-height:48px; text-decoration:none; }
 .roles-section { padding-block:64px 80px; }
 .section-label h2 { font-size:clamp(2rem,3.5vw,2.75rem); }
 .roles { margin-top:36px; }
 .roles > li { display:grid; grid-template-columns:200px minmax(0,1fr); gap:48px; padding-block:32px; border-top:1px solid var(--line); }
 .roles .role-date { color:var(--muted); font-size:1rem; }
 .roles h3 { font-family:var(--display); font-weight:400; font-size:1.625rem; line-height:1.3; max-width:780px; }
 .roles .role-organization { color:var(--accent); font-size:1rem; margin-top:10px; }
 .role-context { margin-top:16px; max-width:760px; color:var(--muted); }
 .context-link { display:inline-flex; align-items:center; gap:16px; min-height:44px; font-size:1rem; margin-top:12px; }
 .engineering-case { padding-block:64px; border-bottom:1px solid var(--line); }
 .case-heading { max-width:820px; }
 .case-heading h3 { font-family:var(--display); font-weight:400; font-size:clamp(2rem,3.8vw,3rem); letter-spacing:-.025em; line-height:1.2; }
 .case-heading .case-summary { font-size:1.25rem; margin-top:24px; }
 .case-narrative { margin:36px 0 0; display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:36px; }
 .case-narrative dt { font-weight:600; margin-bottom:12px; font-size:1.125rem; }
 .case-narrative dd { margin:0; color:var(--muted); font-size:1.125rem; line-height:1.6; }
 .engineering-case--lead .case-narrative { grid-template-columns:minmax(0,1fr); gap:24px; max-width:920px; }
 .engineering-case--lead .case-narrative > div { display:grid; grid-template-columns:152px minmax(0,1fr); gap:28px; }
 .engineering-case > :global(figure) { margin-top:40px; }
 .engineering-case .case-methods { display:flex; flex-wrap:wrap; gap:8px 24px; margin-top:36px; padding-top:20px; border-top:1px solid var(--line); color:var(--muted); font-size:1rem; }
 .case-methods span { color:var(--ink); font-weight:600; }
 .capabilities-section { display:grid; grid-template-columns:1fr 1.65fr; gap:64px; padding-block:80px; }
 .capabilities li { padding-block:24px; border-top:1px solid var(--line); }
 .capabilities p { color:var(--muted); margin-top:12px; }
 @media(max-width:1000px) { .case-narrative { grid-template-columns:minmax(0,1fr); gap:24px; max-width:760px; } .capabilities-section { gap:36px; } }
 @media(max-width:800px) { .roles > li { grid-template-columns:minmax(0,1fr); gap:16px; } .capabilities-section { grid-template-columns:minmax(0,1fr); } }
 @media(max-width:600px) {
  .experience-index { gap:0; display:block; }
  .experience-index a { justify-content:space-between; }
  .roles-section,.engineering-case,.capabilities-section { padding-block:44px; }
  .roles { margin-top:28px; }
  .engineering-case--lead .case-narrative > div { grid-template-columns:minmax(0,1fr); gap:0; }
  .case-narrative dd { font-size:1.0625rem; }
  .case-heading .case-summary { font-size:1.1875rem; }
 }
</style>
