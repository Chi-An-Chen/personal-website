---
import '../styles/global.css';
import '../styles/editorial.css';
import { pages, pageUrl, assetUrl, profiles, type PageId } from '../data/profile';
interface Props {
  title: string; description: string; currentPage?: PageId;
  canonicalPath?: string; noindex?: boolean;
}
const { title, description, currentPage, canonicalPath, noindex = false } = Astro.props;
const canonical = new URL(canonicalPath ?? pageUrl(currentPage ?? 'home'), Astro.site!);
const socialImage = new URL(assetUrl('social-preview.png'), Astro.site!);
---
<!doctype html>
<html lang="en" data-design="editorial">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5f0" />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Chi-An Chen" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content="Chi-An Chen — AI research & engineering. Language, vision, and the systems that connect them." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="Chi-An Chen — AI research & engineering" />
    <link rel="icon" type="image/svg+xml" href={assetUrl('favicon.svg')} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header container">
      <a class="wordmark" href={pageUrl('home')} aria-label="Chi-An Chen — Home">Chi-An Chen<span aria-hidden="true">.</span></a>
      <nav class="desktop-navigation" aria-label="Main navigation"><ul class="nav-list plain-list" role="list">
        {pages.map(page => <li><a href={pageUrl(page.id)} aria-current={currentPage === page.id ? 'page' : undefined}>{page.label}</a></li>)}
      </ul></nav>
    </header>
    <main id="main" class="container" tabindex="-1"><slot /></main>
    <footer class="site-footer container">
      <div class="footer-identity"><a class="wordmark" href={pageUrl('home')} aria-label="Chi-An Chen — Home">Chi-An Chen</a><p>AI research & engineering.</p></div>
      <nav aria-label="Footer navigation"><ul class="footer-links plain-list" role="list">
        {pages.filter(page => page.id !== 'home').map(page => <li><a href={pageUrl(page.id)} aria-current={currentPage === page.id ? 'page' : undefined}>{page.label}</a></li>)}
        <li><a href={profiles.linkedin}>LinkedIn <span aria-hidden="true">↗</span></a></li>
        <li><a href={profiles.github}>GitHub <span aria-hidden="true">↗</span></a></li>
      </ul></nav>
    </footer>
  </body>
</html>
