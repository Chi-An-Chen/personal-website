---
import '../styles/global.css';
import '../styles/editorial.css';
import { pages, pageUrl, assetUrl, profiles, type PageId } from '../data/profile';
import { translator, type Locale } from '../i18n';
interface Props {
  title: string; description: string; currentPage?: PageId;
  canonicalPath?: string; noindex?: boolean; locale?: Locale;
  languageTarget?: PageId; languageAnchor?: string;
}
const { title, description, currentPage, canonicalPath, noindex = false, locale = 'en', languageTarget, languageAnchor = '' } = Astro.props;
const t = translator(locale);
const canonical = new URL(canonicalPath ?? pageUrl(currentPage ?? 'home', locale), Astro.site!);
const socialImage = new URL(assetUrl('social-preview.png'), Astro.site!);
const targetPage = languageTarget ?? currentPage ?? 'home';
const languageUrl = (next: Locale) => `${pageUrl(targetPage, next)}${languageAnchor ? `#${languageAnchor}` : ''}`;
const displayName = locale === 'en' ? 'Chi-An Chen' : '陳麒安';
const homeLabel = locale === 'en' ? 'Chi-An Chen — Home' : '陳麒安 Chi-An Chen — 首頁';
const hasOpening = Astro.slots.has('opening');
---
<!doctype html>
<html lang={locale} data-design="editorial" data-opening={hasOpening ? '' : undefined}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={hasOpening ? '#000000' : '#f7f5f0'} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
    <link rel="canonical" href={canonical} />
    {!noindex && currentPage && <>
      <link rel="alternate" hreflang="en" href={new URL(pageUrl(currentPage, 'en'), Astro.site!)} />
      <link rel="alternate" hreflang="zh-Hant" href={new URL(pageUrl(currentPage, 'zh-Hant'), Astro.site!)} />
      <link rel="alternate" hreflang="x-default" href={new URL(pageUrl(currentPage, 'en'), Astro.site!)} />
    </>}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={locale === 'en' ? displayName : '陳麒安 Chi-An Chen'} />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'zh_TW'} />
    <meta property="og:locale:alternate" content={locale === 'en' ? 'zh_TW' : 'en_US'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={t('Chi-An Chen — AI research & engineering. Language, vision, and the systems that connect them.')} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={t('Chi-An Chen — AI research & engineering')} />
    <link rel="icon" type="image/svg+xml" href={assetUrl('favicon.svg')} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('Skip to content')}</a>
    <slot name="opening" />
    <header class="site-header container" id="site-header" tabindex={hasOpening ? '-1' : undefined}>
      <a class="wordmark" href={pageUrl('home', locale)} aria-label={homeLabel}>{displayName}<span aria-hidden="true">.</span>{locale === 'zh-Hant' && <small lang="en">Chi-An Chen</small>}</a>
      <nav class="desktop-navigation" aria-label={t('Main navigation')}><ul class="nav-list plain-list" role="list">
        {pages.map(page => <li><a href={pageUrl(page.id, locale)} aria-current={currentPage === page.id ? 'page' : undefined}>{t(page.label)}</a></li>)}
      </ul></nav>
      <nav class="language-switch" aria-label={t('Language')}>
        <a href={languageUrl('zh-Hant')} lang="zh-Hant" hreflang="zh-Hant" aria-label="切換至繁體中文" aria-current={locale === 'zh-Hant' ? 'true' : undefined}>繁中</a>
        <span aria-hidden="true">/</span>
        <a href={languageUrl('en')} lang="en" hreflang="en" aria-label="Switch to English" aria-current={locale === 'en' ? 'true' : undefined}>EN</a>
      </nav>
    </header>
    <main id="main" class="container" tabindex="-1"><slot /></main>
    <footer class="site-footer container">
      <div class="footer-identity"><a class="wordmark" href={pageUrl('home', locale)} aria-label={homeLabel}>{displayName}{locale === 'zh-Hant' && <small lang="en">Chi-An Chen</small>}</a><p>{t('AI research & engineering.')}</p></div>
      <nav aria-label={t('Footer navigation')}><ul class="footer-links plain-list" role="list">
        {pages.filter(page => page.id !== 'home').map(page => <li><a href={pageUrl(page.id, locale)} aria-current={currentPage === page.id ? 'page' : undefined}>{t(page.label)}</a></li>)}
        <li><a href={profiles.linkedin} lang="en">LinkedIn <span aria-hidden="true">↗</span></a></li>
        <li><a href={profiles.github} lang="en">GitHub <span aria-hidden="true">↗</span></a></li>
      </ul></nav>
    </footer>
  </body>
</html>
